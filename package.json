{
  "name": "diplomatic-dictionary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=\"--max-old-space-size=4096\" && next dev",
    "build": "set NODE_OPTIONS=\"--max-old-space-size=4096\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs=require('fs');['.next','out'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});console.log('Removed '+d);}catch(e){}})\"",
    "predeploy": "npm run clean && npm run lint && npm run format && npm run format:check && npm run type-check && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-color": "^3.2.1",
    "@tiptap/extension-highlight": "^3.3.0",
    "@tiptap/extension-image": "^3.3.0",
    "@tiptap/extension-link": "^3.2.1",
    "@tiptap/extension-list": "^3.3.0",
    "@tiptap/extension-placeholder": "^3.2.1",
    "@tiptap/extension-task-item": "^3.2.1",
    "@tiptap/extension-task-list": "^3.2.1",
    "@tiptap/extension-text-align": "^3.3.0",
    "@tiptap/extension-text-style": "^3.2.1",
    "@tiptap/extension-underline": "^3.2.1",
    "@tiptap/extensions": "^3.3.0",
    "@tiptap/pm": "^3.3.0",
    "@tiptap/react": "^3.3.0",
    "@tiptap/starter-kit": "^3.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "axios": "^1.11.0",
    "fuse.js": "^7.3.0",
    "js-cookie": "^3.0.5",
    "lru-cache": "^11.3.5",
    "lucide-react": "^0.539.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "24.10.7",
    "@types/react": "18.3.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.2",
    "prettier": "^3.6.2",
    "sass": "^1.91.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
