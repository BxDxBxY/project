# Environment Configuration Template

# Copy this file to .env.development for local development
# Copy this file to .env.production for production deployment

# =============================================================================
# BACKEND URL (Server-side only - NOT exposed to browser)
# =============================================================================
# This is used by Next.js API routes to communicate with the Django backend
# The browser never sees this URL
BACKEND_URL=http://localhost:8000

# =============================================================================
# FRONTEND API URL (Browser-side - exposed to client)
# =============================================================================
# This tells the browser where to send API requests
# Should ALWAYS point to the Next.js proxy (/api) for security
# NEVER point directly to the backend from the browser
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api

# =============================================================================
# RECAPTCHA KEYS
# =============================================================================
# IMPORTANT: Generate new keys before production deployment!
# Get keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
