# Backend URL Configuration
# The base URL where the Python backend is running
BACKEND_URL=http://your-backend-ip:8000

# The base URL the browser uses to fetch data directly
NEXT_PUBLIC_API_URL=http://your-backend-ip:8000
NEXT_PUBLIC_API_BASE_URL=http://your-backend-ip:8000

# Google reCAPTCHA v3 keys
# Used to protect the Contact Form. The script is loaded only when the user
# starts filling in the form (see src/lib/useLazyRecaptcha.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here

# Google Analytics (GA4) measurement ID.
# Analytics is loaded ONLY after the visitor accepts optional cookies
# (see src/components/analytics/ConsentedAnalytics.tsx).
# If this variable is not set, the historical project ID is used as a fallback.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
